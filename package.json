{
  "name": "@smithey-lab/captcha-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint src backend scripts",
    "test": "node --test backend/*.test.cjs backend/*.test.mjs",
    "check:public": "node scripts/check-public.mjs",
    "ci": "npm run lint && npm test && npm run build && npm run check:public",
    "build:backend": "node scripts/sandbox-build.mjs && node scripts/sandbox-infra.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.1131.0",
    "@aws-sdk/client-dynamodb": "3.1131.0",
    "@aws-sdk/lib-dynamodb": "3.1131.0",
    "bedrock-agentcore": "0.4.4",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
